# Скопируйте этот файл в .env и заполните значения. Сам .env в git не попадает.

# Пароль базы данных: случайный, сгенерируйте командой  openssl rand -hex 16
DB_PASSWORD=

# Адрес сайта: для ссылок-приглашений и защиты от запросов с чужих сайтов.
# На ноутбуке — http://localhost:8080, на сервере — https://ваш-домен
SITE_URL=http://localhost:8080

TZ=Europe/Moscow
# Во сколько присылать вам утреннюю сводку (занятия на сегодня)
DIGEST_TIME=08:00
# Когда отправлять родителям отчёт за неделю (за час до этого придёт напоминание дописать комментарии)
REPORT_DAY=SUNDAY
REPORT_TIME=18:00
